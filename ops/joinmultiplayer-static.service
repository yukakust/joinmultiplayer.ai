[Unit]
Description=joinmultiplayer.ai static site
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /srv/joinmultiplayer/app/server.py --site /srv/joinmultiplayer/public --db /var/lib/joinmultiplayer/contributions.sqlite3 --host 127.0.0.1 --port 8091 --model-assets /srv/gpu-static
Restart=on-failure
RestartSec=2
DynamicUser=true
StateDirectory=joinmultiplayer
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

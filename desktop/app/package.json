{
  "name": "pocket-i-desktop",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "Pocket i desktop alpha",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepare:runtime": "node prepare-runtime.cjs",
    "test": "node --test tests/*.test.cjs",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ai.joinmultiplayer.pocketi",
    "productName": "Pocket i",
    "asar": true,
    "files": [
      "main.cjs",
      "chat.cjs",
      "setup.cjs",
      "model-manifest.json",
      "runtime-manifest.json",
      "preload.cjs",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "sidecar-current",
        "to": "sidecar"
      },
      {
        "from": "runtime-current",
        "to": "runtime"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage"]
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg"]
    }
  }
}
